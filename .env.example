# Password for the opencode web UI AND the MCP endpoint (one secret, both doors).
OPENCODE_SERVER_PASSWORD=change-me

# Container user matching your host UID/GID, so files in ./workspace stay yours.
UID=1000
GID=1000

TZ=Europe/Madrid

# Optional: defaults for the bridge's delegate_* tools.
# OPENCODE_DEFAULT_PROVIDER_ID=
# OPENCODE_DEFAULT_MODEL_ID=
